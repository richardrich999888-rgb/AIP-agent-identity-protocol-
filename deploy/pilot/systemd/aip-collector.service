# Off-host collector daemon (aip-collector), Phase 1.
#
# The daemon is env-driven (see collector.env.example); it takes no CLI flags.
# Runs on the collector host ONLY — never on an observed agent host. Build the
# binary with `cargo build --release -p aip-collector` and install it at
# /usr/local/bin/aip-collector.

[Unit]
Description=AIP off-host collector (holds the signing key; attests observation batches)
Documentation=file:/opt/aip/deploy/pilot/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aip-collector
Group=aip-collector

# Passphrase for the wrapped signing key, delivered by the secret manager. The
# daemon reads $CREDENTIALS_DIRECTORY/collector-passphrase automatically.
# Populate via a drop-in that sets the source, e.g.:
#   LoadCredential=collector-passphrase:/run/secrets/aip-collector-passphrase
LoadCredential=collector-passphrase

EnvironmentFile=/etc/aip/collector.env
ExecStart=/usr/local/bin/aip-collector
Restart=on-failure
RestartSec=2

# Hardening: the collector is the trust anchor; lock it down.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/aip-collector
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
