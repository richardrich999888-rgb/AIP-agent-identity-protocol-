# Host-side probe daemon (aip-probe), Phase 1.
#
# The daemon is env-driven (see probe.env.example); it takes no CLI flags. Runs
# on each observed AGENT host. Holds a transport-auth key only; no evidence key.
# Build with `cargo build --release -p aip-probe`, install at /usr/local/bin.

[Unit]
Description=AIP host-side probe (kernel-mediated observation; holds no evidence key)
Documentation=file:/opt/aip/deploy/pilot/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aip-probe
Group=aip-probe

EnvironmentFile=/etc/aip/probe.env
ExecStart=/usr/local/bin/aip-probe
Restart=on-failure
RestartSec=2

# Least privilege: the perf tracepoints need CAP_PERFMON; the netlink
# process-event connector (sensor `connector`) needs CAP_NET_ADMIN in the
# initial network namespace. The connector is what makes the pilot's coverage
# gate-independent — without it no non-occurrence claim can be licensed — so
# both are granted by default. Add CAP_SYS_ADMIN / CAP_NET_RAW only when Phase
# 1.x adds fanotify / AF_PACKET sensors. Trim this to what the configured
# AIP_PROBE_SENSORS actually require.
NoNewPrivileges=yes
AmbientCapabilities=CAP_PERFMON CAP_NET_ADMIN
CapabilityBoundingSet=CAP_PERFMON CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The probe writes only its transport key file; grant just that path.
ReadWritePaths=/var/lib/aip-probe
# AF_NETLINK is the connector's socket family.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes

[Install]
WantedBy=multi-user.target
