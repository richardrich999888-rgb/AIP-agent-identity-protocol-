# Off-host collector configuration (example) — see deploy/pilot/README.md
#
# This host holds the ONLY signing key. It runs on a DIFFERENT machine from any
# observed agent host. Copy to /etc/aip/collector.env, fill in, keep out of
# version control. The daemon reads all of the below from the environment
# (aip_collector::config); the passphrase comes from a credential file, never
# from a persistent environment variable.

# Stable identity the collector signs under. Verifiers trust (observer_id, key_version).
AIP_COLLECTOR_OBSERVER_ID=aip-collector.institution.example
AIP_COLLECTOR_KEY_VERSION=1

# Wrapped signing-key file (argon2 + XChaCha20-Poly1305). Created on first start
# on THIS host. 0600, owned by the service user. Never copied to an agent host.
AIP_COLLECTOR_KEY_PATH=/var/lib/aip-collector/collector.key.wrapped

# The key passphrase is delivered by the secret manager as a systemd credential
# named 'collector-passphrase' (see systemd/aip-collector.service). The daemon
# reads $CREDENTIALS_DIRECTORY/collector-passphrase automatically. To point at a
# file explicitly instead, set AIP_COLLECTOR_PASSPHRASE_FILE. Never put the
# passphrase itself in this file or a persistent env var.
# AIP_COLLECTOR_PASSPHRASE_FILE=/run/secrets/aip-collector-passphrase

# Continuity policy. 'strict' (default) for the pilot: after amnesia, rollback,
# or a forked record the collector REFUSES to sign, writes a signed report, and
# exits. 'advisory' continues on the archived head and reports.
AIP_COLLECTOR_CONTINUITY=strict

# Persistent state directory (chain snapshot, health archive, continuity
# reports). Backed up per the institution's DR plan (BFSI_PILOT_PLAN B3).
AIP_COLLECTOR_STATE_DIR=/var/lib/aip-collector/state

# Allow-list of probes: a JSON array of {"probe_id","transport_pubkey_hex"}.
# A probe may submit only if its exact (id, 32-byte key) pair is listed. A
# probe prints its transport public key on first start; add it here.
AIP_COLLECTOR_PROBES_PATH=/etc/aip/probes.json

# Listen address for the authenticated probe -> collector transport.
AIP_COLLECTOR_LISTEN=0.0.0.0:8443

RUST_LOG=info
