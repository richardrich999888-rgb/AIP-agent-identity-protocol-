# Host-side probe configuration (example) — see deploy/pilot/README.md
#
# Runs on each observed AGENT host. Holds NO key and has no signing method by
# construction (ProcfsProbe has neither). It reads kernel-mediated evidence and
# ships unsigned ObservationBatches to the off-host collector, which signs them.
#
# Copy to probe.env, fill in, keep out of version control.

# Probe identity, registered in the collector's probe registry so a host-side
# party cannot label its own report as a mechanism it was not provisioned for.
AIP_PROBE_ID=probe.$(hostname -s).bank.example

# The off-host collector to ship batches to (authenticated transport is a
# Phase-1 build item; this documents the intended shape).
AIP_PROBE_COLLECTOR_ENDPOINT=aip-collector.bank.example:8443

# Which kernel-mediated sensors to open. All are passive readers; none load an
# eBPF program, none intercept, filter, or block. Comma-separated.
#   sched      = sched_process_{fork,exec}  (perf tracepoint)
#   sockstate  = inet_sock_set_state         (perf tracepoint)
#   socksend   = sock_send_length            (perf tracepoint)
#   connector  = netlink process connector   (gate-independent)
#   fanotify   = FAN_CLOSE_WRITE on named mounts (gate-independent)
#   afpacket   = AF_PACKET header tap        (gate-independent)
AIP_PROBE_SENSORS=sched,sockstate,socksend,connector,fanotify

# Mounts to watch for completed writes (fanotify). Least-privilege: name only
# the paths the pilot's agents write to, not the whole filesystem.
AIP_PROBE_FANOTIFY_MOUNTS=/var/lib/pilot-agent

# The probe requires CAP_PERFMON (perf tracepoints) and CAP_SYS_ADMIN/CAP_NET_RAW
# for fanotify / AF_PACKET. Grant the minimum the chosen AIP_PROBE_SENSORS need;
# do NOT run as full root if the capability set suffices.

RUST_LOG=info
