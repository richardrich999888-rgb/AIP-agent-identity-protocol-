# Host-side probe configuration (example) — see deploy/pilot/README.md
#
# Runs on each observed AGENT host. Holds a transport-auth key only; it has no
# evidence-signing key and no method to attest an observation. It reads
# kernel-mediated evidence and ships unsigned ObservationBatches to the off-host
# collector, which signs them. The daemon reads all of the below from the
# environment (aip_probe::config). Copy to /etc/aip/probe.env.

# Probe identity, registered in the collector's allow-list and probe registry.
AIP_PROBE_ID=probe.host1.institution.example

# The off-host collector to ship batches to.
AIP_PROBE_COLLECTOR_ENDPOINT=aip-collector.institution.example:8443

# The probe's transport-auth keypair (JSON, hex). Generated 0600 on first start
# if absent; the daemon then prints the public key to add to the collector's
# allow-list (AIP_COLLECTOR_PROBES_PATH). This is NOT an evidence key.
AIP_PROBE_KEY_PATH=/var/lib/aip-probe/transport.key.json

# Sensors to open (comma-separated). Phase 1 drives the three perf tracepoints;
# the gate-independent sources (connector, fanotify, afpacket) are Phase 1.x and
# requesting one is a startup error, not a silent no-op.
#   sched      = sched_process_{fork,exec}  (perf tracepoint)
#   sockstate  = inet_sock_set_state         (perf tracepoint)
#   socksend   = sock_send_length            (perf tracepoint)
AIP_PROBE_SENSORS=sched,sockstate

# How often to build and ship a batch, milliseconds (default 2000, floor 100).
AIP_PROBE_BATCH_INTERVAL_MS=2000

# The probe needs CAP_PERFMON for the perf tracepoints. Grant the minimum the
# chosen sensors need; do not run as full root if a capability set suffices.

RUST_LOG=info
