# Host-side probe configuration (example) — see deploy/pilot/README.md
#
# Runs on each observed AGENT host. Holds a transport-auth key only; it has no
# evidence-signing key and no method to attest an observation. It reads
# kernel-mediated evidence and ships unsigned ObservationBatches to the off-host
# collector, which signs them. The daemon reads all of the below from the
# environment (aip_probe::config). Copy to /etc/aip/probe.env.

# Probe identity, registered in the collector's allow-list and probe registry.
AIP_PROBE_ID=probe.host1.institution.example

# The off-host collector to ship batches to.
AIP_PROBE_COLLECTOR_ENDPOINT=aip-collector.institution.example:8443

# The collector's Noise static public key, pinned (R9). The link is
# Noise_NK_25519_ChaChaPoly_SHA256: a capture shows neither this probe's
# identity nor any batch metadata. The collector prints this value at every
# start ("noise static public key"). 64 hex digits; the probe refuses to start
# without it — there is no plaintext mode in the daemon.
AIP_PROBE_COLLECTOR_NOISE_PUBKEY=<64 hex digits from the collector's start-up log>

# The probe's transport-auth keypair (JSON, hex). Generated 0600 on first start
# if absent; the daemon then prints the public key to add to the collector's
# allow-list (AIP_COLLECTOR_PROBES_PATH). This is NOT an evidence key.
AIP_PROBE_KEY_PATH=/var/lib/aip-probe/transport.key.json

# Sensors to open (comma-separated). Phase 1 drives the three perf tracepoints
# and the netlink process-event connector. Keep `connector` on: it is the only
# gate-independent source (a foreign eBPF program on a tracepoint cannot
# silence it) and the only one whose coverage lets the reconciler state that a
# process never appeared; without it PHANTOM_CLAIM is unreachable and the
# observer answers CANNOT_PROVE. `fanotify` and `afpacket` (R8) are two more
# gate-independent sources; both are driven, and each costs a capability
# named below. A requested sensor that cannot be opened is a startup error,
# never a silent no-op.
#   sched      = sched_process_{fork,exec}  (perf tracepoint, CAP_PERFMON)
#   sockstate  = inet_sock_set_state         (perf tracepoint, CAP_PERFMON)
#   socksend   = sock_send_length            (perf tracepoint, CAP_PERFMON)
#   connector  = netlink process events      (CAP_NET_ADMIN, initial net ns)
#   fanotify   = file close-after-write      (CAP_SYS_ADMIN — see below)
#   afpacket   = AF_PACKET device tap        (CAP_NET_RAW)
AIP_PROBE_SENSORS=sched,sockstate,connector

# ── fanotify (R8): filesystem evidence ──
# Marks the MOUNT holding this path (FAN_MARK_MOUNT) for FAN_CLOSE_WRITE: one
# event per completed write-and-close, carrying a pidfd the kernel made from
# the event's own process reference, so the acting instance is bound by the
# kernel rather than by a pid number. Nothing is read from the file; no
# content ever enters a batch (I23).
#
# REQUIRED when `fanotify` is in AIP_PROBE_SENSORS — the probe refuses to
# start without it, because the mark's scope is the mount and there is no
# safe default (marking `/` on a busy host is a firehose whose queue
# overflows, and an overflow is counted loss that degrades the epoch).
# Choose the mount the agent actually writes to.
#
# Cost: CAP_SYS_ADMIN on the observed host. That is close to root. Enable
# this sensor only where the file evidence is worth that grant.
# AIP_PROBE_FANOTIFY_PATH=/var/lib/agent-workspace

# ── afpacket (R8): wire evidence ──
# Binds an AF_PACKET tap and records TCP/IP HEADERS ONLY — addresses, ports,
# flags, sequence numbers and the payload LENGTH. No payload byte is copied,
# hashed or kept (I23). The device layer knows no task, so a wire segment is
# never bound to a process instance: it proves bytes crossed a device, not
# who sent them.
#
# Optional. Unset binds every device, which is the safer default on a host
# whose interfaces change (a container host, a bonded NIC) — a named
# interface that disappears would otherwise silently stop producing
# evidence. Set it to narrow the tap.
# Cost: CAP_NET_RAW.
# AIP_PROBE_AFPACKET_INTERFACE=eth0

# How often to build and ship a batch, milliseconds (default 2000, floor 100).
AIP_PROBE_BATCH_INTERVAL_MS=2000

# The probe needs CAP_PERFMON for the perf tracepoints and CAP_NET_ADMIN for
# the connector (both granted by deploy/pilot/systemd/aip-probe.service). Grant
# the minimum the chosen sensors need; do not run as full root if a capability
# set suffices. Every perf-tracepoint sensor also reports its integrity finding
# (a foreign eBPF program on its tracepoint, or a refused check) in each batch;
# the collector signs IntegrityUnknown when any finding is not clean.

RUST_LOG=info
