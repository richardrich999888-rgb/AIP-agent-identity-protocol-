# Experiment outputs. Regenerated by run.sh; never inputs to anything.
traces/*
replay/*
reports/*
!traces/.gitkeep
!replay/.gitkeep
!reports/.gitkeep

# The consolidated validation matrix is a deliverable, not a run artefact.
!reports/AIRI_VALIDATION_MATRIX.csv
!reports/AIRI_VALIDATION_MATRIX.json

# Build artefacts of the instrument driver.
scenarios/*/recorder/target/
scenarios/*/recorder/Cargo.lock
scenarios/*/agent/target/
scenarios/*/agent/Cargo.lock
airi/agent/target/
airi/agent/Cargo.lock

# The AIRI experiment's canonical run set is EVIDENCE, not scratch output, and
# is committed: the mandate requires raw artefacts to be preserved with their
# metadata. Exploratory and mutation runs stay out.
!traces/airi-final/
!traces/airi-final/**

# The A3S interference cross-check, for the same reason: a statement in
# docs/AIRI_INDEPENDENT_OBSERVATION_REPORT.md §7 rests on it.
!traces/airi-a3s-interference/
!traces/airi-a3s-interference/**

# Observation-integrity: the compiled interference instrument is a build
# artefact; its source is tracked. Sealed result runs ARE kept as evidence.
observation_integrity/tracepoint_interferer
observation_integrity/*.o
