{
  "receivers": {"otlp": {"protocols": {"http": {"endpoint": "127.0.0.1:${PORT}"}}}},
  "exporters": {"file": {"path": "${OUTPUT}", "format": "json", "flush_interval": "100ms"}},
  "service": {
    "telemetry": {"logs": {"level": "error"}, "metrics": {"level": "none", "readers": []}},
    "pipelines": {"traces": {"receivers": ["otlp"], "exporters": ["file"]}}
  }
}
