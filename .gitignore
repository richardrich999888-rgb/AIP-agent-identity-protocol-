# Rust build artifacts
target/
**/*.rs.bk

# OS noise
.DS_Store

# Local key material and logs — never commit
*.key
*.jsonl

# Local API keys (use keys.example.json as a template)
deploy/docker/keys.json

# Python bytecode caches (sdk/python)
__pycache__/
*.py[cod]

# R19 RED suite per-host report (generated)
validation/red_suite/report.json

# Pilot e2e demonstration. Keep only the sealed evidence the adversarial
# ledger cites; never the throwaway key material, and not every ad-hoc run.
validation/pilot_e2e/results/*
!validation/pilot_e2e/results/sealed
validation/pilot_e2e/results/sealed/work/
validation/pilot_e2e/results/sealed/interferer
# The signed health archive IS the evidence the adversarial ledger cites, so
# it overrides the global *.jsonl rule above.
!validation/pilot_e2e/results/sealed/*.jsonl

# Phase 5 harness fixtures: synthetic health captures, must be committed so
# the parser has known-good input to validate against on a fresh checkout.
!adversarial/rootkit-runbooks/fixtures/*.jsonl
