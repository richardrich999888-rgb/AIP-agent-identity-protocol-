{
  "schema": "syntriass.teach-session/v1",
  "session_id": "97b3419aeacd5e3ddfbbb9308908d2e8ed38d9a2e28c50171eb031f42ded63f8",
  "tenant": "halvorn-power",
  "task": "tx_acceptance",
  "expert_id": "expert:halvorn-power-lead",
  "document": "halvorn-hu-tx-2.txt",
  "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
  "pages": [
    1
  ],
  "clauses": [
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 0,
      "text": "halvorn-power|hu-tx-2|restricted|HU-TX-2 rev A Distribution transformer insulation acceptance\nHalvorn Power procedure HU-TX-2 revision A.",
      "char_start": 0,
      "char_end": 137,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 1,
      "text": "Confidential.",
      "char_start": 138,
      "char_end": 151,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 2,
      "text": "Scope:",
      "char_start": 152,
      "char_end": 158,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 3,
      "text": "oil-immersed distribution transformers rated up to and including 33 kV.",
      "char_start": 159,
      "char_end": 230,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 4,
      "text": "This procedure does not apply to motors, cables, generators or dry-type transformers;",
      "char_start": 231,
      "char_end": 316,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 5,
      "text": "such requests are out of scope.",
      "char_start": 317,
      "char_end": 348,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 6,
      "text": "Transformers rated above 33 kV are out of scope.",
      "char_start": 349,
      "char_end": 397,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 7,
      "text": "Required inputs:",
      "char_start": 398,
      "char_end": 414,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 8,
      "text": "rated high-voltage winding voltage in kV, insulation resistance from the high-voltage winding to earth in megohms, top-oil temperature in degrees Celsius, and dielectric absorption ratio (DAR).",
      "char_start": 415,
      "char_end": 608,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 9,
      "text": "If any input is missing the result is insufficient input.",
      "char_start": 609,
      "char_end": 666,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 10,
      "text": "Step 1 validity:",
      "char_start": 667,
      "char_end": 683,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 11,
      "text": "the top-oil temperature must be between 0 and 90 degrees Celsius inclusive;",
      "char_start": 684,
      "char_end": 759,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 12,
      "text": "otherwise the test is invalid.",
      "char_start": 760,
      "char_end": 790,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 13,
      "text": "Step 2 temperature correction:",
      "char_start": 791,
      "char_end": 821,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 14,
      "text": "correct the insulation resistance to 20 degrees Celsius by multiplying it by 2 raised to the power of (top-oil temperature minus 20) divided by 15.",
      "char_start": 822,
      "char_end": 969,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 15,
      "text": "Step 3 minimum:",
      "char_start": 970,
      "char_end": 985,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 16,
      "text": "the minimum acceptable corrected resistance is 20 times (rated kV plus 2) megohms.",
      "char_start": 986,
      "char_end": 1068,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 17,
      "text": "Step 4 decision:",
      "char_start": 1069,
      "char_end": 1085,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 18,
      "text": "if the corrected resistance is below one third of the minimum, remove the transformer from service.",
      "char_start": 1086,
      "char_end": 1185,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 19,
      "text": "If it is below the minimum, dry out the oil and retest.",
      "char_start": 1186,
      "char_end": 1241,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 20,
      "text": "If DAR is below 1.25, investigate.",
      "char_start": 1242,
      "char_end": 1276,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 21,
      "text": "If DAR is at least 1.25 but below 1.4, monitor and retest in 90 days.",
      "char_start": 1277,
      "char_end": 1346,
      "extraction": "txt"
    },
    {
      "document": "halvorn-hu-tx-2.txt",
      "document_sha256": "1c502b5940db2b1524b73bba60c77505863b19db1c0047547ec06caeb0233bbf",
      "page": 1,
      "index": 22,
      "text": "Otherwise accept.",
      "char_start": 1347,
      "char_end": 1364,
      "extraction": "txt"
    }
  ],
  "rule": "Accept only a transformer whose corrected resistance meets the HU-TX-2 minimum and whose DAR is acceptable.\n",
