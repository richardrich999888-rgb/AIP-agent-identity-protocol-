{"id": "koravi.ep114.ir-acceptance.learned", "version": 1, "intended_task": "Motor winding insulation-resistance acceptance per Koravi EP-114 rev C", "outcomes": ["PASS", "RETEST_30D", "DRY_OUT", "REJECT", "INVALID_TEST", "OUT_OF_SCOPE", "INSUFFICIENT_INPUT"], "applicability": {"any_terms": ["IR", "Mohm", "MΩ", "insulation", "megger", "megohm", "megohms", "motor"], "min_inputs_present": 4}, "procedure": {"inputs": [{"name": "rated_voltage", "kind": "voltage", "cues": []}, {"name": "measured_insulation", "kind": "resistance", "cues": []}, {"name": "winding_temperature", "kind": "temperature", "cues": []}, {"name": "polarization_index", "kind": "cued", "cues": ["PI", "polarization index"]}], "text_guards": [{"any_terms": ["transformer", "transformers", "cable", "cables", "generator", "generators"], "outcome": "OUT_OF_SCOPE"}], "numeric_guards": [{"when": "rated_voltage > 11", "outcome": "OUT_OF_SCOPE"}], "missing_input_outcome": "INSUFFICIENT_INPUT", "derive": [{"name": "corrected_resistance", "expr": "measured_insulation * 2 ^ ((winding_temperature - 40) / 10)"}, {"name": "minimum", "expr": "10 * (rated_voltage + 1)"}], "rules": [{"when": "winding_temperature < 10 or winding_temperature > 75", "outcome": "INVALID_TEST"}, {"when": "corrected_resistance < 0.5 * minimum", "outcome": "REJECT"}, {"when": "corrected_resistance < minimum", "outcome": "DRY_OUT"}, {"when": "polarization_index < 1.5", "outcome": "DRY_OUT"}, {"when": "polarization_index < 2.0", "outcome": "RETEST_30D"}], "default_outcome": "PASS"}, "required": {"tenant": "koravi-process", "min_clearance": "restricted", "security_domain": "koravi-ot"}, "dependencies": {"knowledge": {"ep-114": ""}, "policy_version": "ep-114-revC", "execution_model_sha256": null}, "evidence_refs": ["ep-114", "demo-000", "demo-001", "demo-002", "demo-003", "demo-004", "demo-005"], "failure_conditions": ["an input appears twice with different values", "a unit the runtime does not recognise"], "tests": [], "proposed_by": "model:d7efb