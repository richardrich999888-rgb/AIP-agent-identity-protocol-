{
 "id": "halvorn.hubt4.cell-float.compiled",
 "version": 1,
 "intended_task": "Stationary battery cell float acceptance per Halvorn HU-BT-4 rev B",
 "outcomes": [
  "ACCEPT",
  "EQUALIZE",
  "REPLACE_CELL",
  "REDUCE_FLOAT",
  "INVALID_TEST",
  "OUT_OF_SCOPE",
  "INSUFFICIENT_INPUT"
 ],
 "applicability": {
  "any_terms": [
   "vented lead-acid cells",
   "substation",
   "UPS battery banks",
   "V",
   "volt",
   "volts",
   "kV",
   "cell float voltage in volts",
   "CELL FLOAT VOLTAGE IN VOLTS"
  ],
  "min_inputs_present": 2
 },
 "procedure": {
  "inputs": [
   {
    "name": "voltage",
    "kind": "voltage",
    "cues": []
   },
   {
    "name": "temperature",
    "kind": "temperature",
    "cues": []
   },
   {
    "name": "cued_1",
    "kind": "cued",
    "cues": [
     "cell float voltage in volts",
     "CELL FLOAT VOLTAGE IN VOLTS"
    ]
   }
  ],
  "text_guards": [
   {
    "any_terms": [
     "lithium",
     "nickel-cadmium",
     "NiCd"
    ],
    "outcome": "OUT_OF_SCOPE"
   }
  ],
  "numeric_guards": [
   {
    "when": "voltage > 0.003",
    "outcome": "OUT_OF_SCOPE"
   }
  ],
  "missing_input_outcome": "INSUFFICIENT_INPUT",
  "derive": [
   {
    "name": "corrected",
    "expr": "voltage + 0.000003 * (temperature - 25.0)"
   }
  ],
  "rules": [
   {
    "when": "temperature < 5.0 or temperature > 45.0",
    "outcome": "INVALID_TEST"
   },
   {
    "when": "corrected < 0.0021000000000000003",
    "outcome": "REPLACE_CELL"
   },
   {
    "when": "corrected < 0.00217",
    "outcome": "EQUALIZE"
   }
  ],
  "default_outcome": "ACCEPT"
 },
 "required": {
  "tenant": "halvorn-power",
  "min_clearance": "restricted",
  "security_domain": "halvorn-ot"
 },
 "dependencies": {
  "knowledge": {
   "hu-bt-4": ""
  },
  "policy_version": "hu-bt-4-revB",
  "execution_model_sha256": null
 },
 "evidence_refs": [
  "hu-bt-4",
  "demo-0",
  "demo-1",
  "demo-2",
  "demo-3",
  "demo-4",
  "demo-5"
 ],
 "failure_conditions": [
  "an input appears twice with different values",
  "a unit the runtime does not recognise"
 ],
 "tests": [],
