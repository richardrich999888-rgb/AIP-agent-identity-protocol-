    "name": "corrected",
    "expr": "resistance * 2.0 ^ ((temperature - 40.0) / 10.0)"
   },
   {
    "name": "limit",
    "expr": "10.0"
   }
  ],
  "rules": [
   {
    "when": "temperature < 10.0 or temperature > 75.0",
    "outcome": "INVALID_TEST"
   },
   {
    "when": "corrected < 0.5 * limit",
    "outcome": "REJECT"
   },
   {
    "when": "resistance < 1.5",
    "outcome": "DRY_OUT"
   },
   {
    "when": "resistance < 2.0",
    "outcome": "RETEST_30D"
   }
  ],
  "default_outcome": "PASS"
