{
 "id": "koravi.ep114.ir-acceptance.learned",
 "version": 1,
 "intended_task": "Motor winding insulation-resistance acceptance per Koravi EP-114 rev C",
 "outcomes": [
  "PASS",
  "RETEST_30D",
  "DRY_OUT",
  "REJECT",
  "INVALID_TEST",
  "OUT_OF_SCOPE",
  "INSUFFICIENT_INPUT"
 ],
 "applicability": {
  "any_terms": [
   "induction motor",
   "rated voltage",
   "insulation resistance",
   "winding temperature",
   "polarization index"
  ],
  "min_inputs_present": 2
 },
 "procedure": {
  "inputs": [
   {
    "name": "rated_voltage",
    "kind": "voltage",
    "cues": []
   },
   {
    "name": "measured_insulation",
    "kind": "resistance",
    "cues": []
   },
   {
    "name": "winding_temperature",
    "kind": "temperature",
    "cues": []
   },
   {
    "name": "polarization_index",
    "kind": "cued",
    "cues": [
     "PI",
     "polarization index"
    ]
   }
  ],
  "text_guards": [
   {
    "any_terms": [
     "transformers",
     "cables",
     "generators",
     "motors rated above 11 kV"
    ],
    "outcome": "OUT_OF_SCOPE"
   }
  ],
  "numeric_guards": [
   {
    "when": "winding_temperature < 10 or winding_temperature > 75",
    "outcome": "OUT_OF_SCOPE"
   }
  ],
  "missing_input_outcome": "INSUFFICIENT_INPUT",
  "derive": [
   {
    "name": "corrected_insulation",
    "expr": "measured_insulation * 2 ^ (winding_temperature - 40) / 10"
   }
  ],
  "rules": [
   {
    "when": "winding_temperature < 10 or winding_temperature > 75",
    "outcome": "INVALID_TEST"
   },
   {
    "when": "corrected_insulation < 0",
    "outcome": "REJECT"
   },
   {
    "when": "corrected_insulation < 10 and winding_temperature > 200",
    "outcome": "RETEST_30D"
   },
   {
    "when": "corrected_insulation < 10 and winding_temperature <= 200",
    "outcome": "PASS"
   },
   {
    "when": "corrected_insulation >= 10 and PI < 1.5",
    "outcome": "DRY_OUT"
   },
   {
    "when": "PI >= 1.5 and PI < 2.0",
    "outcome": "PASS"
   },
   {
    "when": "PI >= 2.0",
    "outcome": "PASS"
   }
  ],
  "default_outcome": "INSUFFICIENT_INPUT"
 },
 "required": {
  "tenant": "koravi-process",
  "min_clearance": "restricted",
  "security_domain": "koravi-ot"
 },
 "dependencies": {
  "knowledge": {
   "ep-114": ""
  },
  "policy_version": "ep-114-revC",
  "execution_model_sha256": null
 },
 "evidence_refs": [
  "ep-114",
  "demo-000",
  "demo-001",
  "demo-002",
  "demo-003",
  "demo-004",
  "demo-005"
 ],
 "failure_conditions": [
  "an input appears twice with different values",
  "a unit the runtime does not recognise"
 ],
 "tests": [],
 "proposed_by": "model:d7efb072e7724d25048a4fda0a3e10b04bdef5d06b1403a1c93bd9f1240a63c8"
}